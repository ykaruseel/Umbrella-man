  dialogueText: {fileID: 1844148174}
  dialogueLines:
  - speakerName: 
    sentence: "You\u2019ve gotta be kidding me\u2026 that was my TV."
  - speakerName: 
    sentence: But why would they leave it out there? I should get it back before
      someone takes it.
  - speakerName: 
    sentence: "Looks like a few more of my things are missing too. Maybe they\u2019re
      scattered around the building as well."
