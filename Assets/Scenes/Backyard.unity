  m_Script: {fileID: 11500000, guid: b8c04f9a53713ec49b096fe986a51575, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  commentsGO: {fileID: 1721760448}
  dialogueText: {fileID: 1844148174}
  dialogueLines:
  - speakerName: 
    sentence: It turned out the rope holding the cement bag had snapped under the
      weight and constant friction. Just an accident.
  - speakerName: 
    sentence: If I'd been standing a little farther ahead, I probably wouldn't have
      made it.
  - speakerName: 
    sentence: Ever since then, I always speed up when I pass that spot. I just can't
      help it.
  typingSpeed: 0.03
  fadeDuration: 0.2
  autoCloseAfterLastLine: 1
  autoCloseDelay: 0.5
