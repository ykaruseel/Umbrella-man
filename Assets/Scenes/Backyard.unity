  m_Name: 
  m_EditorClassIdentifier: 
  commentsGO: {fileID: 1721760448}
  dialogueText: {fileID: 1844148174}
  dialogueLines:
  - speakerName: 
    sentence: Damn rat. At least it didn't bite me. Who knows what kind of diseases
      those things carry.
  - speakerName: 
    sentence: I have to admit... lately I've been starting to think I'm losing my
      mind.
  - speakerName: 
    sentence: It all started the day I saw the man with the umbrella. This is how
      it happened.
