  m_Script: {fileID: 11500000, guid: b8c04f9a53713ec49b096fe986a51575, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  commentsGO: {fileID: 1721760448}
  dialogueText: {fileID: 1844148174}
  dialogueLines:
  - speakerName: 
    sentence: Then I saw him... the man with the umbrella.
  - speakerName: 
    sentence: I'd never seen him before that day, and I haven't seen him since.
  - speakerName: 
    sentence: He just stood there, staring at me. What was he even doing with an
      umbrella?
  - speakerName: 
    sentence: It was a bright, sunny day... and he was standing on the fire escape.
  typingSpeed: 0.03
  fadeDuration: 0.2
  autoCloseAfterLastLine: 0
  autoCloseDelay: 0.5
